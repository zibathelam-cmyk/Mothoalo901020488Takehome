# Server (port chosen for this build)
PORT=5057

# PostgreSQL connection string (local server port 1231, dedicated database)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:1231/bukahub_db

# A title is flagged for restock when copies_on_hand is below this number
LOW_STOCK_THRESHOLD=2

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5190

# Optional: credential used for the first seed only
# CIRCULATOR_PASSWORD=deskPass!26
